{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalaStudio Upload",
  "version": "../package.json",
  "identifier": "net.talastudio.upload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TalaStudio Upload",
        "width": 1040,
        "height": 760,
        "minWidth": 360,
        "minHeight": 240,
        "visible": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TalaStudio",
    "shortDescription": "Send team files to the TalaStudio Drive",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBM0IxREFCNkQ5MkZFNkQKUldSdC9wSnRxeDA3ZW5zYUhkSTdIVWpiR0ZYMFNDQkMyT1RaT2czcjZQY2h3cW8xMmQ4Z3ZrNzAK",
      "endpoints": [
        "https://upload.talastudio.net/app/update?current={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
